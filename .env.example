# ================================
# UBuilder AI — Environment Variables
# ================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/ubuilder

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
BETTER_AUTH_SECRET=generate-a-random-32-char-string-here
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI Providers ----
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIza...

# ---- Payments ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Storage (Cloudflare R2) ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ubuilder-media
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.yourdomain.com

# ---- Email ----
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ---- Search ----
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ---- App URLs ----
NEXT_PUBLIC_APP_URL=http://localhost:3001
API_URL=http://localhost:8787
RENDERER_URL=http://localhost:3002

# ---- Monitoring (optional for dev) ----
SENTRY_DSN=
POSTHOG_KEY=
